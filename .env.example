# Tezgah — dağıtım değişkenleri.
#
# Bu dosyayı .env olarak kopyalayıp doldurun. .env depoya girmez; Coolify
# kullanıyorsanız aynı isimleri panelin ortam değişkenleri bölümüne yazın.

# --- zorunlu ---------------------------------------------------------------

# SQL Server sa parolası. En az 8 karakter; büyük harf, küçük harf, rakam ve
# sembol içermeli, yoksa konteyner açılmaz.
MSSQL_SA_PASSWORD=

# JWT imzalama anahtarı. HMAC-SHA512 kullanılıyor, en az 64 karakter verin.
# Üretmek için:  openssl rand -base64 64
JWT_SECRET=

# İlk yönetici kullanıcısının (admin) parolası.
ADMIN_PASSWORD=

# --- yayın -----------------------------------------------------------------

# Kendi başına çalışan yığında Caddy'nin dinleyeceği adres.
# Alan adı yazarsanız (demo.ornek.com) Caddy Let's Encrypt sertifikasını kendisi
# alır; bunun için 80 ve 443 dışarı açık olmalı. Yerelde ":80" bırakın.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# Coolify varyantında alan adını panel atar; bu değişkeni Coolify doldurur.
SERVICE_FQDN_CLIENT_80=

# Ana veritabanının adı.
MAIN_DB_NAME=TezgahDb

# Coolify varyantının çekeceği imaj etiketi. GitHub Actions her dalı kendi adıyla,
# master'ı ayrıca "latest" olarak etiketliyor.
IMAGE_TAG=latest

# SQL Server'ın sunucunun localhost'una bağlanacağı port ve bellek tavanı.
# Aynı sunucuda başka bir SQL yığını varsa 1433 doludur; çakışmayan bir port verin.
SQL_HOST_PORT=1434
SQL_MEM_LIMIT=1200m
MSSQL_MEMORY_LIMIT_MB=768

# --- demo ------------------------------------------------------------------

DEMO_ENABLED=true

# Hazır bekletilen sandbox veritabanı sayısı. Aynı zamanda eşzamanlı ziyaretçi
# tavanı: bir ziyaretçi tam olarak bir slot tutar. Her slot ~50 MB yer kaplıyor.
DEMO_SLOT_COUNT=3
DEMO_DB_PREFIX=Tezgah_Demo_

# Bir oturumun harcayabileceği yazma işlemi ve iletişim davetinin eşiği.
DEMO_WRITE_LIMIT=40
DEMO_NUDGE_AFTER=18

# Boşta kalma ve toplam oturum süresi (dakika).
DEMO_IDLE_MINUTES=5
DEMO_SESSION_MINUTES=15

# Süreç bu değeri aşarsa en uzun süredir dokunulmayan oturumlar bırakılır.
DEMO_MEMORY_MB=1024

# Oturumu biten ziyaretçinin yönlendirileceği adres.
CONTACT_URL=https://ataberkkaya.com

# --- Demo telemetrisi ------------------------------------------------------
# Demo kullanimi ataberkkaya.com/admin panelinde gorunsun diye uygulamalar
# oturum acilis/kapanis bildirimi gonderir. Anahtar sitedeki API ile ayni
# olmali. Bos birakilirsa bildirim gonderilmez, demo eskisi gibi calisir.
DEMO_TELEMETRY_ENABLED=false
DEMO_TELEMETRY_URL=https://ataberkkaya.com
DEMO_TELEMETRY_KEY=

# --- Defter entegrasyonu ---------------------------------------------------
# Defter fatura kestiginde dogan stok hareketini buraya yazar. Anahtar iki
# tarafta ayni olmali (Defter'de ERP_API_KEY). Bos birakilirsa entegrasyon
# uclari hicbir istegi kabul etmez ve Tezgah tek basina calisir.
ERP_API_KEY=

# --- Demo e-posta dogrulamasi ----------------------------------------------
# Ziyaretci demoya girmeden once adresine gelen kodu giriyor. SmtpHost bos
# birakilirsa mail gonderilemeyecegi icin dogrulama kendiliginden kapanir ve
# demo tek tikla acilir.
MAIL_FROM=
MAIL_FROM_NAME=Tezgah
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_SSL=true

# Adresini bir kez dogrulayan ziyaretci bu sure boyunca kod istemeden donebilir.
DEMO_REQUIRE_EMAIL=true
DEMO_VERIFIED_GRACE_HOURS=24
